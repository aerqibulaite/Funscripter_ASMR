{
  "$defs": {
    "Preset": {
      "additionalProperties": false,
      "properties": {
        "low": {
          "maximum": 100,
          "minimum": 0,
          "title": "Low",
          "type": "integer"
        },
        "high": {
          "maximum": 100,
          "minimum": 0,
          "title": "High",
          "type": "integer"
        },
        "period_ms": {
          "minimum": 2,
          "title": "Period Ms",
          "type": "integer"
        },
        "up_time_ratio": {
          "default": 0.5,
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Up Time Ratio",
          "type": "number"
        }
      },
      "required": [
        "low",
        "high",
        "period_ms"
      ],
      "title": "Preset",
      "type": "object"
    },
    "ProgressCurvePoint": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "maximum": 1,
          "minimum": 0,
          "title": "At",
          "type": "number"
        },
        "preset_id": {
          "title": "Preset Id",
          "type": "string"
        }
      },
      "required": [
        "at",
        "preset_id"
      ],
      "title": "ProgressCurvePoint",
      "type": "object"
    },
    "QualitativeState": {
      "additionalProperties": false,
      "properties": {
        "pace_tier": {
          "default": "unknown",
          "enum": [
            "slow",
            "medium",
            "fast",
            "unknown"
          ],
          "title": "Pace Tier",
          "type": "string"
        },
        "amplitude_tier": {
          "default": "unknown",
          "enum": [
            "small",
            "medium",
            "large",
            "unknown"
          ],
          "title": "Amplitude Tier",
          "type": "string"
        },
        "motion_style": {
          "default": "unknown",
          "enum": [
            "rhythmic",
            "smooth",
            "irregular",
            "hold",
            "unknown"
          ],
          "title": "Motion Style",
          "type": "string"
        },
        "paused": {
          "default": false,
          "title": "Paused",
          "type": "boolean"
        }
      },
      "title": "QualitativeState",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.3",
      "default": "1.3",
      "title": "Schema Version",
      "type": "string"
    },
    "preset_version": {
      "minLength": 1,
      "title": "Preset Version",
      "type": "string"
    },
    "presets": {
      "additionalProperties": {
        "$ref": "#/$defs/Preset"
      },
      "title": "Presets",
      "type": "object"
    },
    "tier_map": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Tier Map",
      "type": "object"
    },
    "initial_state": {
      "$ref": "#/$defs/QualitativeState"
    },
    "action_defaults": {
      "anyOf": [
        {
          "$ref": "#/$defs/QualitativeState"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "progress_curve": {
      "items": {
        "$ref": "#/$defs/ProgressCurvePoint"
      },
      "title": "Progress Curve",
      "type": "array"
    },
    "allow_inferred_controls": {
      "default": false,
      "title": "Allow Inferred Controls",
      "type": "boolean"
    },
    "rhythm_anchors_ms": {
      "additionalProperties": {
        "items": {
          "type": "integer"
        },
        "type": "array"
      },
      "title": "Rhythm Anchors Ms",
      "type": "object"
    },
    "unknown_policy": {
      "enum": [
        "hold_position",
        "maintain_state"
      ],
      "title": "Unknown Policy",
      "type": "string"
    },
    "manual_boundaries_ms": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Manual Boundaries Ms",
      "type": "object"
    },
    "use_empty_timestamp_hints": {
      "default": false,
      "title": "Use Empty Timestamp Hints",
      "type": "boolean"
    },
    "empty_timestamp_convention_confirmed": {
      "default": false,
      "title": "Empty Timestamp Convention Confirmed",
      "type": "boolean"
    },
    "audio_period_tolerance": {
      "default": 0.25,
      "maximum": 1,
      "minimum": 0,
      "title": "Audio Period Tolerance",
      "type": "number"
    },
    "preview_page_ms": {
      "default": 60000,
      "maximum": 600000,
      "minimum": 1000,
      "title": "Preview Page Ms",
      "type": "integer"
    }
  },
  "required": [
    "preset_version",
    "presets",
    "tier_map",
    "unknown_policy"
  ],
  "title": "FusionProfile",
  "type": "object"
}

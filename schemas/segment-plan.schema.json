{
  "$defs": {
    "ContextNote": {
      "additionalProperties": false,
      "properties": {
        "cue_id": {
          "title": "Cue Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "rule_definition",
            "rule_trigger",
            "phase_transition",
            "state_continuation",
            "scene_inference"
          ],
          "title": "Kind",
          "type": "string"
        },
        "summary": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "basis": {
          "enum": [
            "explicit",
            "inferred"
          ],
          "title": "Basis",
          "type": "string"
        },
        "source_cue_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Cue Ids",
          "type": "array"
        },
        "source_evidence": {
          "items": {
            "$ref": "#/$defs/SourceEvidence"
          },
          "minItems": 1,
          "title": "Source Evidence",
          "type": "array"
        },
        "control": {
          "anyOf": [
            {
              "$ref": "#/$defs/ControlDirective"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "cue_id",
        "kind",
        "summary",
        "basis",
        "source_cue_ids",
        "source_evidence"
      ],
      "title": "ContextNote",
      "type": "object"
    },
    "ControlDirective": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "countdown",
            "rhythm_follow",
            "repetition"
          ],
          "title": "Kind",
          "type": "string"
        },
        "sequence_cue_id": {
          "title": "Sequence Cue Id",
          "type": "string"
        },
        "status": {
          "default": "update",
          "enum": [
            "update",
            "reset",
            "end"
          ],
          "title": "Status",
          "type": "string"
        },
        "progress": {
          "anyOf": [
            {
              "$ref": "#/$defs/CountdownProgress"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "count": {
          "anyOf": [
            {
              "maximum": 10000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Count"
        },
        "unit": {
          "default": "unknown",
          "enum": [
            "single_travel",
            "round_trip",
            "unknown"
          ],
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "sequence_cue_id"
      ],
      "title": "ControlDirective",
      "type": "object"
    },
    "CountdownProgress": {
      "additionalProperties": false,
      "properties": {
        "start_value": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Start Value",
          "type": "integer"
        },
        "end_value": {
          "maximum": 10000,
          "minimum": 0,
          "title": "End Value",
          "type": "integer"
        },
        "current_value": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Current Value",
          "type": "integer"
        }
      },
      "required": [
        "start_value",
        "end_value",
        "current_value"
      ],
      "title": "CountdownProgress",
      "type": "object"
    },
    "FusedSegment": {
      "additionalProperties": false,
      "properties": {
        "segment_id": {
          "title": "Segment Id",
          "type": "string"
        },
        "start_ms": {
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        },
        "end_ms": {
          "exclusiveMinimum": 0,
          "title": "End Ms",
          "type": "integer"
        },
        "mode": {
          "enum": [
            "hold_position",
            "preset"
          ],
          "title": "Mode",
          "type": "string"
        },
        "preset_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Preset Id"
        },
        "state": {
          "$ref": "#/$defs/QualitativeState"
        },
        "cue_ids": {
          "items": {
            "type": "string"
          },
          "title": "Cue Ids",
          "type": "array"
        },
        "subtitle_regions": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Subtitle Regions",
          "type": "array"
        },
        "event_ids": {
          "items": {
            "type": "string"
          },
          "title": "Event Ids",
          "type": "array"
        },
        "audio_evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Audio Evidence Ids",
          "type": "array"
        },
        "needs_review": {
          "const": true,
          "title": "Needs Review",
          "type": "boolean"
        },
        "review_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Review Reasons",
          "type": "array"
        },
        "manual_source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Manual Source Id"
        },
        "boundary_status": {
          "enum": [
            "manual_segment",
            "generated_draft"
          ],
          "title": "Boundary Status",
          "type": "string"
        },
        "control": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Control"
        }
      },
      "required": [
        "segment_id",
        "start_ms",
        "end_ms",
        "mode",
        "preset_id",
        "state",
        "cue_ids",
        "subtitle_regions",
        "event_ids",
        "audio_evidence_ids",
        "needs_review",
        "review_reasons",
        "manual_source_id",
        "boundary_status"
      ],
      "title": "FusedSegment",
      "type": "object"
    },
    "FusionProfile": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.3",
          "default": "1.3",
          "title": "Schema Version",
          "type": "string"
        },
        "preset_version": {
          "minLength": 1,
          "title": "Preset Version",
          "type": "string"
        },
        "presets": {
          "additionalProperties": {
            "$ref": "#/$defs/Preset"
          },
          "title": "Presets",
          "type": "object"
        },
        "tier_map": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Tier Map",
          "type": "object"
        },
        "initial_state": {
          "$ref": "#/$defs/QualitativeState"
        },
        "action_defaults": {
          "anyOf": [
            {
              "$ref": "#/$defs/QualitativeState"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "progress_curve": {
          "items": {
            "$ref": "#/$defs/ProgressCurvePoint"
          },
          "title": "Progress Curve",
          "type": "array"
        },
        "allow_inferred_controls": {
          "default": false,
          "title": "Allow Inferred Controls",
          "type": "boolean"
        },
        "rhythm_anchors_ms": {
          "additionalProperties": {
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          "title": "Rhythm Anchors Ms",
          "type": "object"
        },
        "unknown_policy": {
          "enum": [
            "hold_position",
            "maintain_state"
          ],
          "title": "Unknown Policy",
          "type": "string"
        },
        "manual_boundaries_ms": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Manual Boundaries Ms",
          "type": "object"
        },
        "use_empty_timestamp_hints": {
          "default": false,
          "title": "Use Empty Timestamp Hints",
          "type": "boolean"
        },
        "empty_timestamp_convention_confirmed": {
          "default": false,
          "title": "Empty Timestamp Convention Confirmed",
          "type": "boolean"
        },
        "lenient_gating": {
          "default": false,
          "title": "Lenient Gating",
          "type": "boolean"
        },
        "audio_period_tolerance": {
          "default": 0.25,
          "maximum": 1,
          "minimum": 0,
          "title": "Audio Period Tolerance",
          "type": "number"
        },
        "preview_page_ms": {
          "default": 60000,
          "maximum": 600000,
          "minimum": 1000,
          "title": "Preview Page Ms",
          "type": "integer"
        }
      },
      "required": [
        "preset_version",
        "presets",
        "tier_map",
        "unknown_policy"
      ],
      "title": "FusionProfile",
      "type": "object"
    },
    "Preset": {
      "additionalProperties": false,
      "properties": {
        "low": {
          "maximum": 100,
          "minimum": 0,
          "title": "Low",
          "type": "integer"
        },
        "high": {
          "maximum": 100,
          "minimum": 0,
          "title": "High",
          "type": "integer"
        },
        "period_ms": {
          "minimum": 2,
          "title": "Period Ms",
          "type": "integer"
        },
        "up_time_ratio": {
          "default": 0.5,
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Up Time Ratio",
          "type": "number"
        }
      },
      "required": [
        "low",
        "high",
        "period_ms"
      ],
      "title": "Preset",
      "type": "object"
    },
    "ProgressCurvePoint": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "maximum": 1,
          "minimum": 0,
          "title": "At",
          "type": "number"
        },
        "preset_id": {
          "title": "Preset Id",
          "type": "string"
        }
      },
      "required": [
        "at",
        "preset_id"
      ],
      "title": "ProgressCurvePoint",
      "type": "object"
    },
    "QualitativeState": {
      "additionalProperties": false,
      "properties": {
        "pace_tier": {
          "default": "unknown",
          "enum": [
            "slow",
            "medium",
            "fast",
            "unknown"
          ],
          "title": "Pace Tier",
          "type": "string"
        },
        "amplitude_tier": {
          "default": "unknown",
          "enum": [
            "small",
            "medium",
            "large",
            "unknown"
          ],
          "title": "Amplitude Tier",
          "type": "string"
        },
        "motion_style": {
          "default": "unknown",
          "enum": [
            "rhythmic",
            "smooth",
            "irregular",
            "hold",
            "unknown"
          ],
          "title": "Motion Style",
          "type": "string"
        },
        "paused": {
          "default": false,
          "title": "Paused",
          "type": "boolean"
        }
      },
      "title": "QualitativeState",
      "type": "object"
    },
    "SourceEvidence": {
      "additionalProperties": false,
      "properties": {
        "cue_id": {
          "title": "Cue Id",
          "type": "string"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "cue_id",
        "quote"
      ],
      "title": "SourceEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.3",
      "title": "Schema Version",
      "type": "string"
    },
    "profile": {
      "$ref": "#/$defs/FusionProfile"
    },
    "phases": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Phases",
      "type": "array"
    },
    "segments": {
      "items": {
        "$ref": "#/$defs/FusedSegment"
      },
      "title": "Segments",
      "type": "array"
    },
    "event_dispositions": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Event Dispositions",
      "type": "array"
    },
    "state_transitions": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "State Transitions",
      "type": "array"
    },
    "context_notes": {
      "items": {
        "$ref": "#/$defs/ContextNote"
      },
      "title": "Context Notes",
      "type": "array"
    },
    "control_dispositions": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Control Dispositions",
      "type": "array"
    },
    "control_execution": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Control Execution",
      "type": "array"
    },
    "status": {
      "const": "needs_review",
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "profile",
    "phases",
    "segments",
    "event_dispositions",
    "state_transitions",
    "status"
  ],
  "title": "SegmentPlan",
  "type": "object"
}

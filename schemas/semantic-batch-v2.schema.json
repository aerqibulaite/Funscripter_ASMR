{
  "$defs": {
    "ContextNote": {
      "additionalProperties": false,
      "properties": {
        "cue_id": {
          "title": "Cue Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "rule_definition",
            "rule_trigger",
            "phase_transition",
            "state_continuation",
            "scene_inference"
          ],
          "title": "Kind",
          "type": "string"
        },
        "summary": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "basis": {
          "enum": [
            "explicit",
            "inferred"
          ],
          "title": "Basis",
          "type": "string"
        },
        "source_cue_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Cue Ids",
          "type": "array"
        },
        "source_evidence": {
          "items": {
            "$ref": "#/$defs/SourceEvidence"
          },
          "minItems": 1,
          "title": "Source Evidence",
          "type": "array"
        },
        "control": {
          "anyOf": [
            {
              "$ref": "#/$defs/ControlDirective"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "cue_id",
        "kind",
        "summary",
        "basis",
        "source_cue_ids",
        "source_evidence"
      ],
      "title": "ContextNote",
      "type": "object"
    },
    "ControlDirective": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "countdown",
            "rhythm_follow",
            "repetition"
          ],
          "title": "Kind",
          "type": "string"
        },
        "sequence_cue_id": {
          "title": "Sequence Cue Id",
          "type": "string"
        },
        "status": {
          "default": "update",
          "enum": [
            "update",
            "reset",
            "end"
          ],
          "title": "Status",
          "type": "string"
        },
        "progress": {
          "anyOf": [
            {
              "$ref": "#/$defs/CountdownProgress"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "count": {
          "anyOf": [
            {
              "maximum": 10000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Count"
        },
        "unit": {
          "default": "unknown",
          "enum": [
            "single_travel",
            "round_trip",
            "unknown"
          ],
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "sequence_cue_id"
      ],
      "title": "ControlDirective",
      "type": "object"
    },
    "CountdownProgress": {
      "additionalProperties": false,
      "properties": {
        "start_value": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Start Value",
          "type": "integer"
        },
        "end_value": {
          "maximum": 10000,
          "minimum": 0,
          "title": "End Value",
          "type": "integer"
        },
        "current_value": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Current Value",
          "type": "integer"
        }
      },
      "required": [
        "start_value",
        "end_value",
        "current_value"
      ],
      "title": "CountdownProgress",
      "type": "object"
    },
    "CueAssessment": {
      "additionalProperties": false,
      "properties": {
        "cue_id": {
          "title": "Cue Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "processed",
            "no_new_information",
            "ambiguous",
            "excluded",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "cue_id",
        "status",
        "reason"
      ],
      "title": "CueAssessment",
      "type": "object"
    },
    "SemanticEventV2": {
      "additionalProperties": false,
      "properties": {
        "cue_id": {
          "title": "Cue Id",
          "type": "string"
        },
        "intent": {
          "enum": [
            "start",
            "continue",
            "maintain",
            "pause",
            "resume",
            "increase_rate",
            "decrease_rate",
            "unknown"
          ],
          "title": "Intent",
          "type": "string"
        },
        "scope": {
          "enum": [
            "current_section",
            "next_section",
            "uncertain"
          ],
          "title": "Scope",
          "type": "string"
        },
        "anchor": {
          "enum": [
            "cue_start",
            "after_utterance",
            "uncertain"
          ],
          "title": "Anchor",
          "type": "string"
        },
        "pace_tier": {
          "enum": [
            "stop",
            "slow",
            "medium",
            "fast",
            "unknown"
          ],
          "title": "Pace Tier",
          "type": "string"
        },
        "amplitude_tier": {
          "enum": [
            "small",
            "medium",
            "large",
            "unknown"
          ],
          "title": "Amplitude Tier",
          "type": "string"
        },
        "motion_style": {
          "enum": [
            "rhythmic",
            "smooth",
            "irregular",
            "hold",
            "unknown"
          ],
          "title": "Motion Style",
          "type": "string"
        },
        "evidence": {
          "title": "Evidence",
          "type": "string"
        },
        "needs_review": {
          "title": "Needs Review",
          "type": "boolean"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "source_cue_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Cue Ids",
          "type": "array"
        },
        "source_evidence": {
          "items": {
            "$ref": "#/$defs/SourceEvidence"
          },
          "minItems": 1,
          "title": "Source Evidence",
          "type": "array"
        },
        "statement_kind": {
          "enum": [
            "instruction",
            "description",
            "question",
            "conditional",
            "quotation",
            "uncertain"
          ],
          "title": "Statement Kind",
          "type": "string"
        }
      },
      "required": [
        "cue_id",
        "intent",
        "scope",
        "anchor",
        "pace_tier",
        "amplitude_tier",
        "motion_style",
        "evidence",
        "needs_review",
        "reason",
        "source_cue_ids",
        "source_evidence",
        "statement_kind"
      ],
      "title": "SemanticEventV2",
      "type": "object"
    },
    "SourceEvidence": {
      "additionalProperties": false,
      "properties": {
        "cue_id": {
          "title": "Cue Id",
          "type": "string"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "cue_id",
        "quote"
      ],
      "title": "SourceEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.4",
      "title": "Schema Version",
      "type": "string"
    },
    "cue_assessments": {
      "items": {
        "$ref": "#/$defs/CueAssessment"
      },
      "title": "Cue Assessments",
      "type": "array"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/SemanticEventV2"
      },
      "title": "Events",
      "type": "array"
    },
    "context_notes": {
      "items": {
        "$ref": "#/$defs/ContextNote"
      },
      "title": "Context Notes",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "cue_assessments",
    "events"
  ],
  "title": "SemanticBatchV2",
  "type": "object"
}

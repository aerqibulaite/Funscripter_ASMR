{
  "$defs": {
    "AudioAnalysisConfig": {
      "additionalProperties": false,
      "properties": {
        "frame_ms": {
          "default": 40,
          "maximum": 200,
          "minimum": 10,
          "title": "Frame Ms",
          "type": "integer"
        },
        "hop_ms": {
          "default": 10,
          "maximum": 100,
          "minimum": 1,
          "title": "Hop Ms",
          "type": "integer"
        },
        "block_samples": {
          "default": 65536,
          "maximum": 4194304,
          "minimum": 1024,
          "title": "Block Samples",
          "type": "integer"
        },
        "bands_hz": {
          "additionalProperties": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "title": "Bands Hz",
          "type": "object"
        },
        "silence_dbfs": {
          "default": -60.0,
          "maximum": -10,
          "minimum": -120,
          "title": "Silence Dbfs",
          "type": "number"
        },
        "onset_relative_threshold": {
          "default": 0.15,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Onset Relative Threshold",
          "type": "number"
        },
        "periodicity_window_ms": {
          "default": 8000,
          "maximum": 60000,
          "minimum": 1000,
          "title": "Periodicity Window Ms",
          "type": "integer"
        },
        "periodicity_step_ms": {
          "default": 2000,
          "maximum": 60000,
          "minimum": 100,
          "title": "Periodicity Step Ms",
          "type": "integer"
        },
        "min_period_ms": {
          "default": 250,
          "minimum": 50,
          "title": "Min Period Ms",
          "type": "integer"
        },
        "max_period_ms": {
          "default": 2000,
          "minimum": 100,
          "title": "Max Period Ms",
          "type": "integer"
        },
        "min_periodicity_score": {
          "default": 0.6,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Min Periodicity Score",
          "type": "number"
        },
        "min_modulation_ratio": {
          "default": 0.1,
          "exclusiveMinimum": 0,
          "maximum": 2,
          "title": "Min Modulation Ratio",
          "type": "number"
        }
      },
      "title": "AudioAnalysisConfig",
      "type": "object"
    },
    "DeviceConfig": {
      "additionalProperties": false,
      "properties": {
        "allowed_position_range": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allowed Position Range"
        },
        "max_speed_pos_per_sec": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Speed Pos Per Sec"
        },
        "final_interpolation": {
          "const": "linear",
          "default": "linear",
          "title": "Final Interpolation",
          "type": "string"
        }
      },
      "title": "DeviceConfig",
      "type": "object"
    },
    "GenerationConfig": {
      "additionalProperties": false,
      "properties": {
        "initial_position": {
          "default": 50,
          "maximum": 100,
          "minimum": 0,
          "title": "Initial Position",
          "type": "integer"
        },
        "gap_policy": {
          "const": "hold_position",
          "default": "hold_position",
          "title": "Gap Policy",
          "type": "string"
        },
        "presets": {
          "additionalProperties": {
            "$ref": "#/$defs/Preset"
          },
          "title": "Presets",
          "type": "object"
        },
        "segments": {
          "items": {
            "$ref": "#/$defs/Segment"
          },
          "title": "Segments",
          "type": "array"
        }
      },
      "title": "GenerationConfig",
      "type": "object"
    },
    "LLMConfig": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "enum": [
            "llama_cpp",
            "ollama"
          ],
          "title": "Backend",
          "type": "string"
        },
        "base_url": {
          "title": "Base Url",
          "type": "string"
        },
        "model_id": {
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "model_revision": {
          "default": "unspecified",
          "title": "Model Revision",
          "type": "string"
        },
        "quantization": {
          "default": "unspecified",
          "title": "Quantization",
          "type": "string"
        },
        "api_key_env": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Api Key Env"
        },
        "timeout_seconds": {
          "default": 120.0,
          "exclusiveMinimum": 0,
          "maximum": 3600,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "max_retries": {
          "default": 2,
          "maximum": 5,
          "minimum": 0,
          "title": "Max Retries",
          "type": "integer"
        },
        "context_budget_tokens": {
          "default": 32768,
          "minimum": 2048,
          "title": "Context Budget Tokens",
          "type": "integer"
        },
        "max_output_tokens": {
          "default": 4096,
          "minimum": 128,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "safety_tokens": {
          "default": 1024,
          "minimum": 128,
          "title": "Safety Tokens",
          "type": "integer"
        },
        "max_chunk_cues": {
          "default": 32,
          "maximum": 256,
          "minimum": 1,
          "title": "Max Chunk Cues",
          "type": "integer"
        },
        "context_cues": {
          "default": 1,
          "maximum": 8,
          "minimum": 0,
          "title": "Context Cues",
          "type": "integer"
        },
        "semantic_knowledge_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Semantic Knowledge File"
        },
        "token_count_method": {
          "default": "conservative",
          "enum": [
            "conservative",
            "server"
          ],
          "title": "Token Count Method",
          "type": "string"
        },
        "outline_max_phases": {
          "default": 8,
          "maximum": 64,
          "minimum": 1,
          "title": "Outline Max Phases",
          "type": "integer"
        },
        "outline_summary_chars": {
          "default": 160,
          "maximum": 1000,
          "minimum": 40,
          "title": "Outline Summary Chars",
          "type": "integer"
        },
        "thinking": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "const": "backend_default",
              "type": "string"
            }
          ],
          "default": "backend_default",
          "title": "Thinking"
        },
        "temperature": {
          "anyOf": [
            {
              "maximum": 2,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature"
        },
        "top_p": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Top P"
        }
      },
      "required": [
        "backend",
        "base_url",
        "model_id"
      ],
      "title": "LLMConfig",
      "type": "object"
    },
    "Preset": {
      "additionalProperties": false,
      "properties": {
        "low": {
          "maximum": 100,
          "minimum": 0,
          "title": "Low",
          "type": "integer"
        },
        "high": {
          "maximum": 100,
          "minimum": 0,
          "title": "High",
          "type": "integer"
        },
        "period_ms": {
          "minimum": 2,
          "title": "Period Ms",
          "type": "integer"
        },
        "up_time_ratio": {
          "default": 0.5,
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Up Time Ratio",
          "type": "number"
        }
      },
      "required": [
        "low",
        "high",
        "period_ms"
      ],
      "title": "Preset",
      "type": "object"
    },
    "Segment": {
      "additionalProperties": false,
      "properties": {
        "segment_id": {
          "title": "Segment Id",
          "type": "string"
        },
        "start_ms": {
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        },
        "end_ms": {
          "exclusiveMinimum": 0,
          "title": "End Ms",
          "type": "integer"
        },
        "preset_id": {
          "title": "Preset Id",
          "type": "string"
        }
      },
      "required": [
        "segment_id",
        "start_ms",
        "end_ms",
        "preset_id"
      ],
      "title": "Segment",
      "type": "object"
    },
    "SubtitleConfig": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "format": {
          "default": "auto",
          "enum": [
            "auto",
            "lrc",
            "srt",
            "vtt"
          ],
          "title": "Format",
          "type": "string"
        },
        "encoding": {
          "default": "utf-8-sig",
          "title": "Encoding",
          "type": "string"
        },
        "offset_ms": {
          "default": 0,
          "title": "Offset Ms",
          "type": "integer"
        },
        "apply_lrc_offset": {
          "default": true,
          "title": "Apply Lrc Offset",
          "type": "boolean"
        },
        "empty_timestamp_policy": {
          "default": "end_hint",
          "enum": [
            "end_hint",
            "display_clear"
          ],
          "title": "Empty Timestamp Policy",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "title": "SubtitleConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.3",
      "default": "1.3",
      "title": "Schema Version",
      "type": "string"
    },
    "audio": {
      "title": "Audio",
      "type": "string"
    },
    "subtitles": {
      "$ref": "#/$defs/SubtitleConfig"
    },
    "ffmpeg": {
      "default": "ffmpeg",
      "title": "Ffmpeg",
      "type": "string"
    },
    "ffprobe": {
      "default": "ffprobe",
      "title": "Ffprobe",
      "type": "string"
    },
    "audio_stream": {
      "default": 0,
      "minimum": 0,
      "title": "Audio Stream",
      "type": "integer"
    },
    "llm": {
      "anyOf": [
        {
          "$ref": "#/$defs/LLMConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "audio_analysis": {
      "$ref": "#/$defs/AudioAnalysisConfig"
    },
    "generation": {
      "$ref": "#/$defs/GenerationConfig"
    },
    "device": {
      "$ref": "#/$defs/DeviceConfig"
    }
  },
  "required": [
    "audio",
    "subtitles"
  ],
  "title": "Config",
  "type": "object"
}
